<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Lomorage</string>
    <key>CFBundleDisplayName</key>
    <string>Lomorage</string>
    <key>CFBundleIdentifier</key>
    <string>com.lomorage.LomorageTray</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>lomorage-launcher</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>10.13</string>
    <!-- Belt-and-suspenders: the launcher is a real universal (arm64+x86_64) Mach-O binary
         now, which already gives LaunchServices enough info to launch natively without this
         key. It's kept as explicit insurance -- see lomorage-launcher.c's header comment for
         why a non-native (Rosetta-translated) launch silently breaks this app entirely. -->
    <key>LSRequiresNativeExecution</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
