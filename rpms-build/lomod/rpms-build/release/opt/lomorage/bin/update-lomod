#!/bin/sh
# Daily maintenance, run as root by lomod-update.timer: drop a disaster-recovery copy of
# assets.db into every user's home dir, then upgrade the lomorage packages.
set -x

DB=/opt/lomorage/var/assets.db

# nice/ionice everything below: this is routine background maintenance, so it should
# never compete with interactive uploads/requests for CPU or disk I/O.
lowprio() {
  ionice -c3 nice -n 19 "$@"
}

# Best effort: a failed copy (lomod not up yet, jq missing, a full disk) must not keep the
# packages from being upgraded.
copy_db_to_homes() {
  token=$(jq -r '."admin-token"' /opt/lomorage/etc/admin.json) || return 1
  curl -s "127.0.0.1:8000/user?token=$token" | jq -r '.Users[].HomeDir' | while read -r home; do
    if [ -d "$home" ]; then
      lowprio cp "$DB" "$home"
    fi
  done
}

# A run missed while the machine was off is caught up right at boot, often before the
# network is usable. Any HTTP answer at all counts as "up".
wait_for_network() {
  command -v curl >/dev/null 2>&1 || return 0
  tries=0
  while [ "$tries" -lt 30 ]; do
    curl -s --max-time 10 -o /dev/null https://lomoware.lomorage.com/ && return 0
    tries=$((tries + 1))
    sleep 10
  done
  echo "network still unreachable, trying the upgrade anyway"
}

upgrade_apt() {
  # Only name what is installed: apt-get fails the whole command with "Unable to locate
  # package" for a name its repos don't carry at all, and not every distro's repo has the
  # Raspberry Pi extras.
  pkgs=""
  for p in lomo-base lomo-base-lite lomo-vips lomo-backend lomo-frame; do
    if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed"; then
      pkgs="$pkgs $p"
    fi
  done
  lowprio apt-get update -y
  # shellcheck disable=SC2086
  lowprio apt-get --only-upgrade install -y $pkgs
}

copy_db_to_homes || echo "assets.db copy skipped"
wait_for_network

upgrade_rpm() {
  # lomo-vips is optional here too (Fedora uses its own vips package).
  pkgs=""
  for p in lomo-vips lomo-backend; do
    if rpm -q "$p" >/dev/null 2>&1; then
      pkgs="$pkgs $p"
    fi
  done
  if command -v dnf >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    lowprio dnf -y upgrade --refresh $pkgs
  else
    lowprio zypper --non-interactive refresh
    # shellcheck disable=SC2086
    lowprio zypper --non-interactive update $pkgs
  fi
}

if command -v apt-get >/dev/null 2>&1; then
  upgrade_apt
elif command -v dnf >/dev/null 2>&1 || command -v zypper >/dev/null 2>&1; then
  upgrade_rpm
else
  echo "no supported package manager found" >&2
  exit 1
fi
