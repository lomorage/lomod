# Builds libvips from source natively against a given Debian release's own
# library stack. Needed because the amd64 lomo-vips previously published for
# bookworm/trixie turned out to be linked against buster-era SONAMEs
# (libwebp.so.6/libtiff.so.5/libjpeg.so.8) that don't exist on bookworm+
# (confirmed: lomod fails to even load), and buster/bullseye never had an
# amd64 lomo-vips published at all -- same underlying issue that jammy/noble
# hit on the Ubuntu side, just undiscovered here until now.
# Build with --build-arg BASE_IMAGE=debian:bullseye (etc).
ARG BASE_IMAGE=debian:bookworm
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# buster's own mirrors are EOL; point at archive.debian.org instead.
ARG USE_ARCHIVE_MIRROR=false
RUN if [ "$USE_ARCHIVE_MIRROR" = "true" ]; then \
      CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME"); \
      printf 'deb http://archive.debian.org/debian %s main\ndeb http://archive.debian.org/debian-security %s/updates main\ndeb http://archive.debian.org/debian %s-updates main\n' "$CODENAME" "$CODENAME" "$CODENAME" > /etc/apt/sources.list; \
      printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates \
    libglib2.0-dev libexpat1-dev libfftw3-dev libmagickcore-dev \
    liborc-0.4-dev liblcms2-dev libheif-dev zlib1g-dev libwebp-dev \
    libtiff-dev libpng-dev libimagequant-dev libjpeg62-turbo-dev \
    libexif-dev libgsf-1-dev libxml2-dev libde265-dev libopenjp2-7-dev \
    libsqlite3-dev libaom-dev

# Name the CA bundle explicitly. buster's curl reports "CAfile: none, CApath:
# /etc/ssl/certs", so it depends on the hashed symlinks that ca-certificates'
# postinst generates -- and under qemu-arm, which is how the armhf package is
# built, that rehash silently produces none: measured 0 symlinks on armhf
# against 137 on arm64, same image and same package version, while the bundle
# file itself is byte-identical and works the moment curl is told to use it.
# Without this, every https download below dies with "unable to get local
# issuer certificate" -- which is why an armhf buster build of this image has
# never completed here, the vips download fails the same way. Inert on every
# arch and codename where the rehash did run.
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# AVIF previews need a libheif that can decode AV1, which buster's 1.3.2 cannot
# -- it predates AVIF entirely, so the probe does not even compile against it.
# An .avif therefore uploads and stores fine on a buster device but never gets a
# preview; vips 8.12.2 already knows the ftypavif brand, the decoder under it is
# what is missing. Measured per release rather than assumed: bullseye (1.11.0),
# bookworm (1.15.1) and trixie (1.23.6) all decode AVIF with their own libheif,
# so in practice only buster builds one here. The probe decides, not a version
# comparison -- a libheif new enough for the API can still ship with no AV1
# plugin at all, which is exactly what openSUSE Leap 16.0 does.
COPY avif-decode-probe.c /tmp/avif-decode-probe.c
# 1.12.0 is the last libheif whose aom backend still builds against buster's
# libaom 1.0.0 (1.13+ switched to AOM_USAGE_*, which needs aom 2.0), and the
# last that is still autotools, like the vips build below.
ARG LIBHEIF_VERSION=1.12.0
# Its own directory, deliberately not /usr/local: build-vips-debian.sh packages
# everything under /usr/local, so a libheif.so.1 sitting next to libvips would
# land in ldconfig's cache as a second candidate for that soname and silently
# change which libheif *every* program on the device resolves to -- a package
# that claims to provide vips has no business doing that. Under its own prefix
# it never enters the cache, and only libvips, which carries the matching rpath
# below, can see it.
ARG LIBHEIF_PREFIX=/usr/local/lomo-vips
# Compile parallelism. Defaults to nproc, which is right for a native build,
# but an armhf/arm64 build runs every compiler process under qemu on the
# host's full core count while sharing the host's RAM -- 12 jobs on a 7 GB
# WSL box gets the build OOM-killed partway through libvips. Pass
# MAKE_JOBS=2 for those.
ARG MAKE_JOBS=
RUN set -ex; \
    if gcc -o /tmp/avif-probe /tmp/avif-decode-probe.c $(pkg-config --cflags --libs libheif) 2>/dev/null \
       && /tmp/avif-probe; then \
      echo "this release's libheif decodes AVIF, keeping it"; \
    else \
      echo "building libheif ${LIBHEIF_VERSION} from source for AVIF decoding"; \
      curl -fsSL -o /tmp/libheif.tar.gz "https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz"; \
      mkdir /tmp/libheif-src; \
      tar -C /tmp/libheif-src --strip-components=1 -xzf /tmp/libheif.tar.gz; \
      cd /tmp/libheif-src; \
      ./configure --prefix="${LIBHEIF_PREFIX}" --disable-examples --disable-static; \
      make -j"${MAKE_JOBS:-$(nproc)}"; \
      make install; \
      cd /; \
      rm -rf /tmp/libheif-src /tmp/libheif.tar.gz; \
      export PKG_CONFIG_PATH="${LIBHEIF_PREFIX}/lib/pkgconfig"; \
      gcc -o /tmp/avif-probe /tmp/avif-decode-probe.c $(pkg-config --cflags --libs libheif) \
        -Wl,-rpath,"${LIBHEIF_PREFIX}/lib"; \
      /tmp/avif-probe; \
    fi

ARG VIPS_VERSION=8.12.2
# PKG_CONFIG_PATH so configure finds a source-built libheif ahead of the
# release's own; it is prepended to pkg-config's default dirs, so everything
# else is still found where it was. On a release that needed no source build the
# directory simply does not exist, and both this and the rpath below are inert.
#
# The rpath is what decides which libheif libvips loads at *runtime*, and it has
# to be explicit, because the source-built one is somewhere the dynamic linker
# would never look on its own. DT_RUNPATH also takes precedence over the
# ldconfig cache, so this stays correct regardless of how the cache happens to
# be ordered -- which is not the same on every arch, since /etc/ld.so.conf.d is
# read in filename order and libc.conf sorts after aarch64-linux-gnu.conf but
# before x86_64-linux-gnu.conf. Only the libheif prefix goes on the rpath:
# libvips's own libs are in /usr/local/lib, which ldconfig already covers on the
# device today, and widening it would change releases that work.
ENV PKG_CONFIG_PATH=${LIBHEIF_PREFIX}/lib/pkgconfig
RUN set -ex; \
    curl -fsSL -o /tmp/vips.tar.gz "https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.gz"; \
    mkdir /tmp/vips-src; \
    tar -C /tmp/vips-src --strip-components=1 -xzf /tmp/vips.tar.gz; \
    cd /tmp/vips-src; \
    ./configure --prefix=/usr/local --disable-gtk-doc-html --disable-gtk-doc \
      LDFLAGS="-Wl,-rpath,${LIBHEIF_PREFIX}/lib"; \
    make -j"${MAKE_JOBS:-$(nproc)}"; \
    make install; \
    ldconfig; \
    rm -rf /tmp/vips-src /tmp/vips.tar.gz
