# Builds libvips from source natively against a given Ubuntu release's own
# library stack (webp/tiff/ImageMagick etc.), so the resulting lomo-vips
# package's baked-in SONAME requirements (e.g. libwebp.so.7) actually exist
# on that release -- reusing the Debian-buster-built lomo-vips on Ubuntu
# fails because Ubuntu bumped those libraries to incompatible SONAMEs.
# Build with --build-arg BASE_IMAGE=ubuntu:22.04 (jammy) or ubuntu:24.04 (noble).
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates \
    libglib2.0-dev libexpat1-dev libfftw3-dev libmagickcore-dev \
    liborc-0.4-dev liblcms2-dev libheif-dev zlib1g-dev libwebp-dev \
    libtiff-dev libpng-dev libimagequant-dev libjpeg-turbo8-dev \
    libexif-dev libgsf-1-dev libxml2-dev libde265-dev libopenjp2-7-dev \
    libsqlite3-dev

# Same AVIF question the Debian build asks, but here it is only an assertion:
# jammy's libheif is 1.12.0 and noble's 1.17.6, and both decode AV1 with no
# extra package (measured, not assumed). So there is nothing to fix here --
# what this guards is a future release quietly shipping a libheif with no AV1
# decoder, which would yield a lomo-vips that stores .avif uploads and never
# previews them. Failing the build is the right outcome: the fix would be the
# source-built libheif in Dockerfile.debian-vips-build, and taking that on
# should be a deliberate change, not something that happens by accident.
# The build context is the cross-build-rpi root, shared by all four vips
# Dockerfiles so they can use this one probe.
COPY avif-decode-probe.c /tmp/avif-decode-probe.c
RUN set -e; \
    if gcc -o /tmp/avif-probe /tmp/avif-decode-probe.c $(pkg-config --cflags --libs libheif) 2>/dev/null \
       && /tmp/avif-probe; then :; else \
      echo "ERROR: this release's libheif cannot decode AVIF -- a lomo-vips built" >&2; \
      echo "       here would store .avif uploads and never produce a preview." >&2; \
      echo "       See amd64/Dockerfile.debian-vips-build for the source-built" >&2; \
      echo "       libheif recipe, or add the release's AV1 decoder package." >&2; \
      exit 1; \
    fi

ARG VIPS_VERSION=8.12.2
RUN set -ex; \
    curl -fsSL -o /tmp/vips.tar.gz "https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.gz"; \
    mkdir /tmp/vips-src; \
    tar -C /tmp/vips-src --strip-components=1 -xzf /tmp/vips.tar.gz; \
    cd /tmp/vips-src; \
    ./configure --prefix=/usr/local --disable-gtk-doc-html --disable-gtk-doc; \
    make -j"$(nproc)"; \
    make install; \
    ldconfig; \
    rm -rf /tmp/vips-src /tmp/vips.tar.gz
